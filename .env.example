# GEMINI_API_KEY: Required for Gemini AI API calls if used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# PORT: Server port (defaults to 3000)
PORT=3000

# ADMIN_PIN: Required on first boot (6 to 128 chars) to bootstrap Admin dashboard authentication.
ADMIN_PIN=""

# DATABASE_PATH & UPLOADS_DIR: Persistent storage paths (defaults to ./data/darajati.db and ./uploads)
DATABASE_PATH="./data/darajati.db"
UPLOADS_DIR="./uploads"
